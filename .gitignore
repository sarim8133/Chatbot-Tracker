# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local AI tool dirs — agent configs, caches and generated output. Every one of
# these is rebuilt by its own tool, so committing them only makes git status noisy.
.claude
.gemini
.impeccable
.agents/
.codex/
.superpowers/
graphify-out/
skills-lock.json

# Supabase CLI scratch
supabase/.temp/

# Env / secrets
.env
.env.*
!.env.example

# Raw n8n workflow exports land in the download folder as "… (2).json", "… (3).json".
# n8n/ keeps exactly ONE snapshot per workflow, under the workflow's own name; the
# numbered copies are duplicates of it and should not be committed. (An export
# carries credential ids and names, never the secret values — checked before
# committing the two that are in there.)
*(2).json
*(3).json
*(4).json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

