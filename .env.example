# Supabase project. The key is the PUBLISHABLE/anon key (safe to expose in the
# client bundle — RLS protects the data). Copy this file to `.env` and fill in.
VITE_SB_URL=https://YOUR-PROJECT.supabase.co
VITE_SB_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# n8n web-chat webhook — the Chat tab POSTs here. Use the *Production* URL of your
# n8n Webhook node. Not a secret; leave blank to disable the Chat tab gracefully.
VITE_N8N_CHAT_WEBHOOK=https://YOUR-N8N-HOST/webhook/hitech-web-chat

# n8n webhook for receipt image uploads from the website chat (extract + save)
VITE_N8N_RECEIPT_WEBHOOK=
